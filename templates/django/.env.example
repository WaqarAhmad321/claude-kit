# Every environment variable the code reads, one per line, with a safe local value or empty.
# Secrets stay empty here; their real values live in the secret store named in docs/runbooks/deploy.md.
# A variable that is optional, or that the platform sets, is listed commented out: # NAME=
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgis://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
EMAIL_URL=smtp://localhost:1025
# Paid services: an empty key makes the integration report itself unavailable.
# SENTRY_DSN=
# The role matrix runner's inputs; compose.test.yml sets them for the test stack.
# MATRIX_FILE=tests/matrix/roles.yaml
# MATRIX_BASE_URL=http://localhost:8000
