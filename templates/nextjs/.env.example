# Every environment variable the code reads, one per line, with a safe local value or empty.
# Secrets stay empty here; their real values live in the secret store named in docs/runbooks/deploy.md.
# A variable that is optional, or that the platform sets, is listed commented out: # NAME=
# NEXT_PUBLIC_ variables are public and frozen at build time: never put a secret in one.
# The local values come from `supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; it bypasses Row Level Security. Read it only in modules that import "server-only".
# SUPABASE_SECRET_KEY=
# Test-stack logins for the Playwright roles; never a real account.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
