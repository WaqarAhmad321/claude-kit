{
  "gate": {
    "journeys": {
      "command": "pnpm exec playwright test",
      "watch": [
        "src/**",
        "e2e/**",
        "public/**",
        "supabase/migrations/**",
        "supabase/seed.sql",
        "next.config.ts",
        "playwright.config.ts",
        "package.json",
        "pnpm-lock.yaml"
      ]
    },
    "review": {
      "always": [
        "**/auth/**",
        "**/*permission*",
        "**/payments/**",
        "**/billing/**",
        "**/*security*",
        "supabase/migrations/**",
        "src/proxy.ts",
        "src/lib/supabase/**",
        "src/app/**/route.ts",
        "**/actions.ts"
      ]
    }
  }
}
