{
  "stack": "mern",
  "gate": {
    "journeys": {
      "command": "docker compose -f compose.test.yml run --build --rm journeys",
      "watch": [
        "server/src/**",
        "server/test/**",
        "server/migrations/**",
        "server/migrate-mongo-config.js",
        "server/package.json",
        "server/pnpm-lock.yaml",
        "server/pnpm-workspace.yaml",
        "server/tsconfig*.json",
        "server/Dockerfile",
        "compose.test.yml",
        "journeys/**",
        "tests/matrix/**"
      ]
    },
    "review": {
      "always": [
        "**/auth/**",
        "**/*permission*",
        "**/payments/**",
        "**/billing/**",
        "**/*security*",
        "server/migrations/**"
      ]
    }
  }
}
